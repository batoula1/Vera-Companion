{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "Stores user personal safety information and emergency medical notes",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "emergencyMedicalNotes": { "type": "string" },
        "hasCompletedOnboarding": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "trusted_contacts": {
      "title": "Trusted Contact",
      "description": "Emergency contacts added by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "relationship": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "isPrimary": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "name", "phone"]
    },
    "emergency_reports": {
      "title": "Emergency Report",
      "description": "Recorded emergency alert reports generated by Gemini AI",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" },
        "incidentType": { "type": "string" },
        "riskLevel": { "type": "string" },
        "summaryText": { "type": "string" },
        "keyFindings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recommendedActions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "userContext": {
          "type": "object"
        },
        "notifiedContacts": {
          "type": "array"
        }
      },
      "required": ["userId", "timestamp"]
    },
    "notifications": {
      "title": "Emergency Notification",
      "description": "Notifications queued or sent to trusted contacts during an emergency",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "contactName": { "type": "string" },
        "relationship": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "aiEmergencySummary": { "type": "string" },
        "streetAddress": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "googleMapsLink": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["userId", "contactName", "status"]
    }
  }
}
